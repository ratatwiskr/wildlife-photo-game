{
  "name": "wildlife-photo-game",
  "version": "0.1.0",
  "description": "A simple wildlife photography game for kids, playable in the browser or on tablet.",
  "type": "module",
  "scripts": {
    "build": "npm run generate:scenes-manifest && tsc",
    "build:fast": "tsc",
    "build:incremental": "tsc -b",
    "clean": "rm -rf scripts/",
    "tsc:clean": "npm run clean && tsc -b --clean",
    "rebuild": "npm run tsc:clean && npm run build",
    "watch": "tsc --watch",
    "watch:dev": "concurrently \"npm:watch\" \"npm:serve\"",
    "serve": "npx http-server . -p 8090 -c-1",
    "dev": "npm run build && npm run serve",
    "dev:fast": "npm run build:fast && npm run serve",
    "dev:watch": "npm run generate:scenes-manifest && npm run watch:dev",
    "test": "jest --passWithNoTests",
    "cy:devopen": "npm run build && npm run cy:open",
    "cy:open": "npx start-test serve http://127.0.0.1:8090 'cypress open'",
    "cy:run": "npx start-test serve http://127.0.0.1:8090 'cypress run'",
    "validate:scenes": "tsx misc/scripts/validateScenes.ts",
    "generate:scenes-manifest": "tsx misc/scripts/generateSceneManifest.ts",
    "precommit": "npm run validate:scenes"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/pngjs": "^6.0.5",
    "chalk": "^5.3.0",
    "concurrently": "^8.2.2",
    "cypress": "^15.5.0",
    "cypress-terminal-report": "^7.3.3",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "pngjs": "^7.0.0",
    "start-server-and-test": "^2.1.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0"
  },
  "volta": {
    "node": "22.9.0",
    "npm": "10.8.3"
  }
}
